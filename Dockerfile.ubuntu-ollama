ARG PREFIX=llsem-
ARG PARENT_TAG=latest
FROM ${PREFIX}ubuntu:${PARENT_TAG}

# install updates and required packages, and cleanup afterward
RUN DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get -y upgrade && \
    apt-get -y --no-install-recommends install curl zstd && \
    rm -rf /var/lib/apt/lists/*

# pin versions
ARG OLLAMA_VER=0.40.14

# install ollama software
ENV SDKMAN_DIR=/opt/sdkman
RUN curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION=${OLLAMA_VER} sh

# set environment variables
ENV OLLAMA_HOST=host.docker.internal:11434
